{
  "name": "booze",
  "version": "1.0.0",
  "description": "cross platform client http framework",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "dev": "tsx watch ./debug/index.ts",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiNISAL/booze.git"
  },
  "keywords": [
    "http",
    "request",
    "decorator",
    "http framework",
    "xhr",
    "XMLHttpRequest",
    "fetch"
  ],
  "author": "ARAM",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hiNISAL/booze/issues"
  },
  "homepage": "https://github.com/hiNISAL/booze#readme",
  "devDependencies": {
    "@types/isarray": "^2.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "axios": "^1.2.1",
    "axios-jsonp": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@types/qs": "^6.9.7",
    "qs": "^6.11.0"
  }
}
