{
  "name": "booze",
  "version": "2.0.0-beta.0",
  "description": "Describe HTTP APIs with TypeScript decorators: typed results, order-independent decorators, middleware.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "require": {
        "types": "./dist/middleware.d.cts",
        "default": "./dist/middleware.cjs"
      }
    },
    "./adapters/*": {
      "import": {
        "types": "./dist/adapters/*.d.ts",
        "default": "./dist/adapters/*.js"
      },
      "require": {
        "types": "./dist/adapters/*.d.cts",
        "default": "./dist/adapters/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p test/tsconfig.legacy.json",
    "smoke": "node test/smoke/build.mjs && node test/smoke/run.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiNISAL/booze.git"
  },
  "keywords": [
    "http",
    "request",
    "decorator",
    "http framework",
    "fetch",
    "typescript"
  ],
  "author": "ARAM",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hiNISAL/booze/issues"
  },
  "homepage": "https://github.com/hiNISAL/booze#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "axios": ">=1"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@oxc-project/runtime": "0.156.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "axios": "^1.21.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
